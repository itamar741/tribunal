# Server-only PostgreSQL connection string.
# Use the Supabase Database URI (Project Settings → Database).
# Never prefix this with NEXT_PUBLIC_.
# Do not add sslmode, sslrootcert, sslcert, or sslkey to this URI.
# node-postgres would then ignore the application's verified TLS settings.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional. Path to the official Supabase CA (prod-ca-2021.crt).
# Defaults to certs/prod-ca-2021.crt for Supabase hosts.
# Download a replacement from Database Settings → SSL Configuration if needed.
# DATABASE_SSL_CA=certs/prod-ca-2021.crt

# Server-only OpenRouter API key for live model requests.
# Never prefix this with NEXT_PUBLIC_. Never commit the value.
# OPENROUTER_API_KEY=

# Public cost guard. Enable this in production after applying migrations.
# The HMAC secret protects client identifiers; use at least 32 random characters.
# Raw client IP addresses are never stored.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_HMAC_SECRET=
